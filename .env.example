# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Secret key from Stripe Dashboard (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=""

# STRIPE_PUBLISHABLE_KEY: Publishable key from Stripe Dashboard (pk_test_... or pk_live_...)
# Used by Stripe Embedded Checkout and @stripe/react-stripe-js on the client
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Stripe Subscription Price IDs (Optional - if omitted, Stripe creates dynamic subscription line items automatically):
# Monthly Plan ($24.99/mo):
STRIPE_MONTHLY_PRICE_ID=""
# Yearly Plan ($199.99/yr):
STRIPE_YEARLY_PRICE_ID=""
# Legacy alias for monthly:
STRIPE_PRICE_ID=""

# FIREBASE_CONFIG: Client Firebase credentials in JSON or discrete VITE_ vars
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Email configuration (Resend)
RESEND_API_KEY=""
ADMIN_EMAIL="ossovi32@gmail.com"
RESEND_FROM_EMAIL="TapShield <noreply@tapshield.app>"
