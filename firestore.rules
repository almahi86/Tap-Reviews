rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        request.auth.uid == businessId ||
        request.auth.uid == resource.data.ownerUid ||
        request.auth.uid == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
      );
    }

    function isValidBusiness(data) {
      return data.businessName is string &&
             data.businessName.size() > 0 &&
             data.businessName.size() <= 100 &&
             data.googleMapsReviewUrl is string &&
             data.googleMapsReviewUrl.size() <= 500 &&
             data.subscriptionStatus in ['active', 'inactive', 'trialing', 'canceled'];
    }

    function isValidFeedback(data, businessId) {
      return data.businessId == businessId &&
             data.rating in ['dislike', 'like'] &&
             data.customerNote is string &&
             data.customerNote.size() <= 2000 &&
             data.status in ['new', 'reviewed', 'resolved'];
    }

    match /businesses/{businessId} {
      allow get: if isValidId(businessId);
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(businessId) &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       isValidBusiness(request.resource.data);

      allow update: if isSignedIn() &&
                       isBusinessOwner(businessId) &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       isValidBusiness(request.resource.data);

      allow delete: if isSignedIn() && isBusinessOwner(businessId);

      match /feedbacks/{feedbackId} {
        allow get, list, delete: if isBusinessOwner(businessId);

        allow update: if isBusinessOwner(businessId) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'internalNote', 'updatedAt']);

        allow create: if isValidId(feedbackId) &&
                         isValidFeedback(request.resource.data, businessId) &&
                         exists(/databases/$(database)/documents/businesses/$(businessId));
      }
    }
  }
}
