rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && (
        request.auth.uid == businessId ||
        businessId == 'biz_' + request.auth.uid ||
        businessId == 'demo-cafe' ||
        businessId == 'rcB3J0qBydaOGKD44gS0JAbpX9m1' ||
        request.auth.uid == 'rcB3J0qBydaOGKD44gS0JAbpX9m1' ||
        (request.auth.token.email != null && (request.auth.token.email == 'ossovi32@gmail.com' || request.auth.token.email.matches('.*ossovi32.*'))) ||
        (resource != null && 'ownerUid' in resource.data && resource.data.ownerUid == request.auth.uid) ||
        (resource != null && 'ownerEmail' in resource.data && request.auth.token.email != null && resource.data.ownerEmail == request.auth.token.email)
      );
    }

    function isValidBusiness(data) {
      return data.businessName is string &&
             data.businessName.size() > 0 &&
             data.businessName.size() <= 100 &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
             (!('googleMapsReviewUrl' in data) || (data.googleMapsReviewUrl is string && data.googleMapsReviewUrl.size() <= 500)) &&
             (!('subscriptionStatus' in data) || data.subscriptionStatus in ['active', 'inactive', 'trialing', 'canceled', 'past_due']);
    }

    function isValidFeedback(data, businessId) {
      return data.businessId == businessId &&
             data.rating in ['dislike', 'like'] &&
             (!('customerNote' in data) || (data.customerNote is string && data.customerNote.size() <= 2000)) &&
             data.status in ['new', 'reviewed', 'resolved'];
    }

    match /businesses/{businessId} {
      allow get: if isValidId(businessId);
      allow list: if true;

      allow create: if isSignedIn() &&
                       isValidId(businessId) &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       isValidBusiness(request.resource.data);

      allow update: if (
                       isSignedIn() &&
                       isBusinessOwner(businessId) &&
                       (!('ownerUid' in resource.data) || !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == resource.data.ownerUid) &&
                       isValidBusiness(request.resource.data)
                     ) || (
                       // Allow server webhook updates to subscription fields and ownerEmail
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriptionStatus', 'updatedAt', 'ownerEmail', 'stripeCustomerId', 'stripeSubscriptionId']) &&
                       (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus in ['active', 'inactive', 'trialing', 'canceled', 'past_due'])
                     );

      allow delete: if isSignedIn() && isBusinessOwner(businessId);

      match /feedbacks/{feedbackId} {
        // Business owner can ONLY read/manage their own feedback (request.auth.uid == businessId)
        allow read: if isBusinessOwner(businessId) || businessId == 'demo-cafe';

        // Allow any unauthenticated public user to write to it from the NFC page
        allow create: if isValidId(feedbackId) &&
                         (
                           ('sentiment' in request.resource.data && request.resource.data.sentiment in ['positive', 'negative']) ||
                           ('rating' in request.resource.data && request.resource.data.rating in ['like', 'dislike'])
                         );

        allow update, delete: if isBusinessOwner(businessId) || (businessId == 'demo-cafe' && isSignedIn());
      }
    }

    // Temporary 6-digit OTP verification codes - accessible solely via server-side Admin SDK / Cloud Functions
    match /verification_codes/{email} {
      allow read, write: if false;
    }
  }
}
